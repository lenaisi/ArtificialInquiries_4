
@prefix artinq: <https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix o: <http://omeka.org/s/vocabs/o#> .

<https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#>
    a owl:Ontology ;
    dcterms:title "Artificial Inquiries" .

# CLASSES

artinq:ConversationMemorable a rdfs:Class ;
    rdfs:label "Conversation mémorable" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Participant a rdfs:Class ;
    rdfs:label "Participant" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:LLM a rdfs:Class ;
    rdfs:label "Modèle de langage (LLM)" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Emotion a rdfs:Class ;
    rdfs:label "Émotion" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:TypeImpact a rdfs:Class ;
    rdfs:label "Type d'impact" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:CategorieTache a rdfs:Class ;
    rdfs:label "Catégorie de tâche" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

# PROPRIETES GENERALES

artinq:name a rdf:Property ;
    rdfs:label "Nom" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:version a rdf:Property ;
    rdfs:label "Version" ;
    rdfs:domain artinq:LLM ;
    vs:term_status "experimental" .

# PROPRIETES DE CONVERSATION

artinq:content a rdf:Property ;
    rdfs:label "Contenu" ;
    rdfs:domain artinq:ConversationMemorable ;
    vs:term_status "experimental" .

artinq:whyMemorable a rdf:Property ;
    rdfs:label "Pourquoi marquante" ;
    rdfs:domain artinq:ConversationMemorable ;
    vs:term_status "experimental" .

artinq:rating a rdf:Property ;
    rdfs:label "Note" ;
    rdfs:domain artinq:ConversationMemorable ;
    vs:term_status "experimental" .

artinq:performanceEvaluation a rdf:Property ;
    rdfs:label "Évaluation de performance" ;
    rdfs:domain artinq:ConversationMemorable ;
    vs:term_status "experimental" .

artinq:performanceExplanation a rdf:Property ;
    rdfs:label "Explication de performance" ;
    rdfs:domain artinq:ConversationMemorable ;
    vs:term_status "experimental" .

# RELATIONS ENTRE LES CLASSES

artinq:createdBy a rdf:Property ;
    rdfs:label "Créée par" ;
    rdfs:domain artinq:ConversationMemorable ;
    rdfs:range artinq:Participant ;
    vs:term_status "experimental" .

artinq:usesLLM a rdf:Property ;
    rdfs:label "Modèle de langage utilisé" ;
    rdfs:domain artinq:ConversationMemorable ;
    rdfs:range artinq:LLM ;
    vs:term_status "experimental" .

artinq:hasEmotion a rdf:Property ;
    rdfs:label "Émotion caractéristique" ;
    rdfs:domain artinq:ConversationMemorable ;
    rdfs:range artinq:Emotion ;
    vs:term_status "experimental" .

artinq:hasImpactType a rdf:Property ;
    rdfs:label "Type d'impact" ;
    rdfs:domain artinq:ConversationMemorable ;
    rdfs:range artinq:TypeImpact ;
    vs:term_status "experimental" .

artinq:hasTaskCategory a rdf:Property ;
    rdfs:label "Catégorie de tâche" ;
    rdfs:domain artinq:ConversationMemorable ;
    rdfs:range artinq:CategorieTache ;
    vs:term_status "experimental" .
